# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
# `.env` is git-ignored and is never committed.
# ---------------------------------------------------------------------------

# Required. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Any Groq-hosted chat model that supports tool calling.
# Default: openai/gpt-oss-120b
MODEL_NAME=openai/gpt-oss-120b

# Optional. Where the Chinook DDL script is fetched from on startup.
CHINOOK_SQL_URL=https://raw.githubusercontent.com/lerocha/chinook-database/master/ChinookDatabase/DataSources/Chinook_Sqlite.sql

# Optional. HTTP timeout (seconds) for the Chinook download.
CHINOOK_HTTP_TIMEOUT=30
